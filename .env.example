# Copy is created by: python3 scripts/render_config.py init  (fills the generated secrets)
# Never commit .env. Everything below stays on your machine.
# Full reference (required/secret/used-by for every variable): docs/configuration.md

# ---------------------------------------------------------------- generated by init
OPENCLAW_GATEWAY_TOKEN=
MCP_INTERNAL_TOKEN=
A2A_CLIENT_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------- model provider
# provider/model reference used by all agents
OPENCLAW_MODEL=anthropic/claude-sonnet-5
# Either set an API key here, or log in once inside the container:
#   docker compose exec openclaw openclaw models auth login --provider anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------- home
HOME_TZ=Europe/Warsaw
# Optional: forecast location. If empty, the Netatmo station location is used.
HOME_LAT=
HOME_LON=
# Optional: installed PV peak power (kWp) for a rough daily yield estimate
PV_KWP=
# Report schedule (cron, HOME_TZ)
MORNING_REPORT_CRON="0 7 * * *"
EVENING_REPORT_CRON="30 21 * * *"
# Proactive weather alerts (weather-cast; silent when nothing new) and monthly memory maintenance
WEATHER_ALERT_CRON="15 6-21/3 * * *"
MEMORY_MAINTENANCE_CRON="30 3 1 * *"

# ---------------------------------------------------------------- SolaX (dispatcher only)
# https://developer.solaxcloud.com -> Application (client_credentials grant)
SOLAX_CLIENT_ID=
SOLAX_CLIENT_SECRET=
SOLAX_DEVICE_SN=
# true = expose set_battery_self_use_mode (the agent still asks you to confirm first)
SOLAX_ALLOW_CONTROL=false

# ---------------------------------------------------------------- battery planning (dispatcher)
# Used for the morning grid-charge proposal (cheap window) and TOU settings.
BATTERY_CAPACITY_KWH=
# Maximum charging power from the grid, kW
BATTERY_MAX_CHARGE_KW=
# Never discharge below / never grid-charge above (percent)
BATTERY_MIN_SOC=15
BATTERY_TARGET_SOC=90
# Typical daily house consumption, used until the energy log has a few days of data
HOME_DAILY_CONSUMPTION_KWH=

# ---------------------------------------------------------------- Netatmo (weather-cast only)
# https://dev.netatmo.com/apps -> create app; then: python3 scripts/netatmo_auth.py
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
NETATMO_DEVICE_ID=

# ---------------------------------------------------------------- Discord (optional, one bot per agent)
# IDs are not secrets but identify you; they stay in .env and .local/ only.
DISCORD_GUILD_ID=
DISCORD_OWNER_USER_ID=
DISCORD_TEAM_CHANNEL_ID=
DISCORD_REPORT_CHANNEL_ID=
DISCORD_DISPATCHER_BOT_TOKEN=
DISCORD_DISPATCHER_APPLICATION_ID=
DISCORD_DISPATCHER_BOT_USER_ID=
DISCORD_DISPATCHER_CHANNEL_ID=
DISCORD_WEATHER_BOT_TOKEN=
DISCORD_WEATHER_APPLICATION_ID=
DISCORD_WEATHER_BOT_USER_ID=
DISCORD_WEATHER_CHANNEL_ID=
DISCORD_TRADER_BOT_TOKEN=
DISCORD_TRADER_APPLICATION_ID=
DISCORD_TRADER_BOT_USER_ID=
DISCORD_TRADER_CHANNEL_ID=

# ---------------------------------------------------------------- WhatsApp (optional, routed to dispatcher)
WHATSAPP_ENABLED=false
# E.164 numbers allowed to talk to the bot, comma-separated
WHATSAPP_ALLOW_FROM=
# Number that receives scheduled reports (usually your own)
WHATSAPP_REPORT_TO=

# ---------------------------------------------------------------- observability
# true = include prompt/tool content in traces (off by default for privacy)
OTEL_CAPTURE_CONTENT=false

# Optional: send telemetry to another OTLP/HTTP collector (default http://lgtm:4318)
# OTEL_ENDPOINT=

# ---------------------------------------------------------------- docker
HOST_UID=1000
HOST_GID=1000
# Optional version pins (defaults shown); keep plugin version = gateway version
# OPENCLAW_IMAGE_TAG=2026.9.6-browser
# OPENCLAW_PLUGIN_VERSION=2026.9.6
# LGTM_IMAGE_TAG=0.35.0
