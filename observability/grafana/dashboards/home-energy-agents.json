    {
      "type": "row",
      "title": "Traces",
      "id": 19,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      }
    },
    {
      "type": "table",
      "title": "Recent agent runs",
      "id": 20,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"home-energy-agents\" && name=\"openclaw.run\"}",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "table",
      "title": "Errors (any span)",
      "id": 21,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Failed tool calls, model calls, deliveries.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"home-energy-agents\" && status=error}",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "table",
      "title": "MCP tool calls",
      "id": 22,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "solax-cloud__*, netatmo-weather__*, rce-prices__*",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"home-energy-agents\" && name=\"openclaw.tool.execution\" && span.openclaw.toolName=~\".*__.*\"}",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "table",
      "title": "A2A: handoffs and A2A channel",
      "id": 23,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"home-energy-agents\" && ((name=\"openclaw.tool.execution\" && span.openclaw.toolName=~\"sessions_.*\") || span.openclaw.channel=\"a2a\")}",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Gateway logs (warnings and errors)",
      "id": 24,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 60
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"home-energy-agents\"} | severity_text=~\"(?i)warn.*|error|fatal\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "description": "OpenClaw dispatcher / weather-cast / trader: turns, tool calls (MCP), A2A handoffs, statuses and errors."
}