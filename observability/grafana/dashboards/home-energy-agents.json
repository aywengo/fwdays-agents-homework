          },
          "expr": "sum by (openclaw_agent, openclaw_token) (rate({__name__=~\"openclaw_tokens(_total)?\"}[$__rate_interval]))",
          "legendFormat": "{{openclaw_agent}} {{openclaw_token}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
